{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fastapi-backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "stockmoney.api.main:app", "--reload", "--port", "8000"],
      "port": 8000
